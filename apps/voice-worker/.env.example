# LiveKit (LiveKit Cloud project, or a local `livekit-server --dev`: ws://localhost:7880, devkey / secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Web app base URL and shared secret for worker → web calls
WEB_BASE_URL=http://localhost:3000
INTERNAL_API_SECRET=
# Turn detection: multilingual (LiveKit model, best for Turkish) | vad | stt
TURN_DETECTION=multilingual
# Optional own provider keys. Without them, models run through LiveKit Inference (LiveKit Cloud only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
