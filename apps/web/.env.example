# ---- Database ----
# Postgres connection string (Supabase: Project Settings → Database → Connection string, "Transaction pooler").
# Leave empty to use an embedded PGlite database in ./.data (local dev only).
DATABASE_URL=

# ---- Security ----
# Admin mode: open /admin?key=<ADMIN_KEY> once; unlimited usage, all models.
ADMIN_KEY=change-me
# Salt for hashing IPs (never store raw IPs).
IP_HASH_SALT=change-me-too
# Days to keep sessions, messages and logs (KVKK).
RETENTION_DAYS=7
# Bearer token for GET /api/cron/cleanup (daily)
CRON_SECRET=

# ---- Limits ----
DAILY_SESSIONS_PER_IP=20
DAILY_PREMIUM_SESSIONS_PER_IP=3
MAX_MESSAGES_PER_SESSION=40

# ---- LLM providers (at least one) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Voice providers (Phase 3+) ----
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
