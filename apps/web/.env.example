# ---- Database ----
# Postgres connection string (Supabase: Project Settings → Database → Connection string, "Transaction pooler").
# Leave empty to use an embedded PGlite database in ./.data (local dev only).
DATABASE_URL=

# ---- Security ----
# Admin mode: open /admin?key=<ADMIN_KEY> once; unlimited usage, all models.
ADMIN_KEY=change-me
# Salt for hashing IPs (never store raw IPs).
IP_HASH_SALT=change-me-too
# Days to keep sessions, messages and logs (KVKK).
RETENTION_DAYS=7
# Bearer token for GET /api/cron/cleanup (daily)
CRON_SECRET=

# ---- Limits ----
DAILY_SESSIONS_PER_IP=20
DAILY_PREMIUM_SESSIONS_PER_IP=3

# ---- Voice (required) ----
# LiveKit Cloud project (Settings → Keys) or local `livekit-server --dev` (ws://localhost:7880, devkey/secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit Inference (models without own provider keys). Auto-on for *.livekit.cloud URLs; force with 1/0.
LIVEKIT_INFERENCE=
# Shared secret between web app and voice worker (any long random string; same value in apps/voice-worker/.env)
INTERNAL_API_SECRET=
MAX_VOICE_SECONDS=180
# Cloudflare Turnstile (bot check before a call). Optional but recommended in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- LLM key for the Task Guard classifier (at least one) ----
# Also lets the voice worker use these models directly (set the same key in apps/voice-worker/.env).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Own voice provider keys (optional; otherwise LiveKit Inference). Used only to show availability here,
# the worker reads its own copy. ----
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
